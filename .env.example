# --- Postgres (docker compose) ---
POSTGRES_USER=clubinnings
POSTGRES_PASSWORD=clubinnings
POSTGRES_DB=clubinnings
POSTGRES_PORT=5432

# --- API ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://clubinnings:clubinnings@localhost:5432/clubinnings
# Separate database used by `make test` (created by docker/postgres/init)
TEST_DATABASE_URL=postgres://clubinnings:clubinnings@localhost:5432/clubinnings_test
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173
